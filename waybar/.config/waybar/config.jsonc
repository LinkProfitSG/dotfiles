{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "height": 30,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin": "5",

  "include": [
    "$HOME/.config/waybar/modules/*.jsonc",
    "$HOME/.config/waybar/modules/custom/*.jsonc"
  ],

  "modules-left": [ "hyprland/workspaces" ],

  "modules-center": [
    "mpris"
  ],

  "modules-right": [
    "custom/notification",
    "custom/kdeconnect",
    "bluetooth",
    "network",
    "clock",
    "backlight"
  ]
}
