{
  "wireplumber#sink": {
    "format": "{icon}",
		"tooltip": true,
		"tooltip-format": "{desc}: {volume}%",
		"format-muted": "",
		"on-click": "pwvucontrol",
		"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5x+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5x-",
		"scroll-step": 5,
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		}
  },
  "wireplumber#source": {
    "format": "󰍬"
  }
}
